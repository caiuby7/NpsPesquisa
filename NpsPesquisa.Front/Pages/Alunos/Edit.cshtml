@page "{id:int}"
@model NpsPesquisa.Front.Pages.Alunos.EditModel
@{
    ViewData["Title"] = "Editar Aluno";
}

<h2>Editar Aluno</h2>
<form method="post">
    <div class="form-group">
        <label>Nome</label>
        <input asp-for="Aluno.Nome" class="form-control" />
    </div>
    <div class="form-group">
        <label>Email</label>
        <input asp-for="Aluno.Email" class="form-control" />
    </div>
    <div class="form-group">
        <label>Curso ID</label>
        <input asp-for="Aluno.CursoId" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a asp-page="Index" class="btn btn-secondary">Voltar</a>
</form> 
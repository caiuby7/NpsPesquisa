@page "{id:int}"
@model NpsPesquisa.Front.Pages.Alunos.DetailsModel
@{
    ViewData["Title"] = "Detalhes do Aluno";
}

<h2>Detalhes do Aluno</h2>
<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Model.Aluno.Nome</h5>
        <p><strong>Email:</strong> @Model.Aluno.Email</p>
        <p><strong>Curso ID:</strong> @Model.Aluno.CursoId</p>
        <a asp-page="Edit" asp-route-id="@Model.Aluno.Id" class="btn btn-primary">Editar</a>
        <a asp-page="Index" class="btn btn-secondary">Voltar</a>
    </div>
</div> 
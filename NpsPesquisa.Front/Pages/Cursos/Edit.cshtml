@page "{id:int}"
@model NpsPesquisa.Front.Pages.Cursos.EditModel
@{
    ViewData["Title"] = "Editar Curso";
}

<h2>Editar Curso</h2>
<form method="post">
    <div class="form-group">
        <label>Nome</label>
        <input asp-for="Curso.Nome" class="form-control" />
    </div>
    <div class="form-group">
        <label>Descrição</label>
        <input asp-for="Curso.Descricao" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a asp-page="Index" class="btn btn-secondary">Voltar</a>
</form> 
@page
@model NpsPesquisa.Front.Pages.Cursos.IndexModel
@{
    ViewData["Title"] = "Cursos";
}

<h2>Cursos</h2>
<a asp-page="Create" class="btn btn-success mb-3">Novo Curso</a>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Descrição</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var c in Model.Cursos)
    {
        <tr>
            <td>@c.Nome</td>
            <td>@c.Descricao</td>
            <td>
                <a asp-page="Edit" asp-route-id="@c.Id" class="btn btn-primary btn-sm">Editar</a>
                <a asp-page="Details" asp-route-id="@c.Id" class="btn btn-info btn-sm">Detalhes</a>
                <form method="post" asp-page-handler="Delete" asp-route-id="@c.Id" style="display:inline;">
                    <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table> 
@page "{id:int}"
@model NpsPesquisa.Front.Pages.Cursos.DetailsModel
@{
    ViewData["Title"] = "Detalhes do Curso";
}

<h2>Detalhes do Curso</h2>
<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Model.Curso.Nome</h5>
        <p><strong>Descrição:</strong> @Model.Curso.Descricao</p>
        <a asp-page="Edit" asp-route-id="@Model.Curso.Id" class="btn btn-primary">Editar</a>
        <a asp-page="Index" class="btn btn-secondary">Voltar</a>
    </div>
</div> 
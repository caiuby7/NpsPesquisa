@page
@model NpsPesquisa.Front.Pages.Questions.IndexModel
@{
    ViewData["Title"] = "Questões";
}

<h2>Questões</h2>
<a asp-page="Create" class="btn btn-success mb-3">Nova Questão</a>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Título</th>
            <th>Tipo</th>
            <th>Obrigatória</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var q in Model.Questions)
    {
        <tr>
            <td>@q.Title</td>
            <td>@q.Type</td>
            <td>@(q.Required ? "Sim" : "Não")</td>
            <td>
                <a asp-page="Edit" asp-route-id="@q.Id" class="btn btn-primary btn-sm">Editar</a>
                <a asp-page="Details" asp-route-id="@q.Id" class="btn btn-info btn-sm">Detalhes</a>
                <form method="post" asp-page-handler="Delete" asp-route-id="@q.Id" style="display:inline;">
                    <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table> 
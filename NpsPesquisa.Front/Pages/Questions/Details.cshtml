@page "{id:int}"
@model NpsPesquisa.Front.Pages.Questions.DetailsModel
@{
    ViewData["Title"] = "Detalhes da Questão";
}

<h2>Detalhes da Questão</h2>
<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Model.Question.Title</h5>
        <p><strong>Tipo:</strong> @Model.Question.Type</p>
        <p><strong>Obrigatória:</strong> @(Model.Question.Required ? "Sim" : "Não")</p>
        <p><strong>Opções:</strong> @(Model.Question.Options != null ? string.Join(", ", Model.Question.Options) : "-")</p>
        <a asp-page="Edit" asp-route-id="@Model.Question.Id" class="btn btn-primary">Editar</a>
        <a asp-page="Index" class="btn btn-secondary">Voltar</a>
    </div>
</div> 
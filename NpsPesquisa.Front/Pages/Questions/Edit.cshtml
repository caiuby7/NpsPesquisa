@page "{id:int}"
@model NpsPesquisa.Front.Pages.Questions.EditModel
@{
    ViewData["Title"] = "Editar Questão";
}

<h2>Editar Questão</h2>
<form method="post">
    <div class="form-group">
        <label>Título</label>
        <input asp-for="Question.Title" class="form-control" />
    </div>
    <div class="form-group">
        <label>Tipo</label>
        <select asp-for="Question.Type" class="form-control">
            <option value="multiple_choice">Múltipla escolha</option>
            <option value="checkbox">Caixas de seleção</option>
            <option value="text">Resposta curta</option>
        </select>
    </div>
    <div class="form-group">
        <label>Opções (separadas por vírgula)</label>
        <input asp-for="OptionsInput" class="form-control" />
    </div>
    <div class="form-group">
        <label>Obrigatória</label>
        <input asp-for="Question.Required" type="checkbox" />
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a asp-page="Index" class="btn btn-secondary">Voltar</a>
</form> 
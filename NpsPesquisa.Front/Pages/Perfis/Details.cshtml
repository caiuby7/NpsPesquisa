@page "{id:int}"
@model NpsPesquisa.Front.Pages.Perfis.DetailsModel
@{
    ViewData["Title"] = "Detalhes do Perfil";
}

<h2>Detalhes do Perfil</h2>
<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Model.Perfil.Nome</h5>
        <p><strong>Descrição:</strong> @Model.Perfil.Descricao</p>
        <a asp-page="Edit" asp-route-id="@Model.Perfil.Id" class="btn btn-primary">Editar</a>
        <a asp-page="Index" class="btn btn-secondary">Voltar</a>
    </div>
</div> 
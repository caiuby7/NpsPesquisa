@page
@model NpsPesquisa.Front.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <a class="navbar-brand" href="#"><span style="font-size: 1.5rem;">🐵</span> Logo</a>
    <div class="collapse navbar-collapse">
        <ul class="navbar-nav mr-auto">
            <li class="nav-item active"><a class="nav-link" href="/">Home</a></li>
            <li class="nav-item"><a class="nav-link" href="/Questions/Create">Criar Questão</a></li>
            <li class="nav-item"><a class="nav-link" href="#">Criar Formulário</a></li>
            <li class="nav-item"><a class="nav-link" href="#">Formulários</a></li>
            <li class="nav-item"><a class="nav-link" href="#">Questões</a></li>
        </ul>
        <span class="navbar-text">
            <img src="https://randomuser.me/api/portraits/men/1.jpg" class="rounded-circle" width="40" height="40" />
        </span>
    </div>
</nav>

<div class="container mt-5">
    <h3 class="text-center">Painel Administrativo</h3>
    <div class="row justify-content-center mt-4">
        <div class="col-md-3 mb-3">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="bi bi-link-45deg" style="font-size:2rem;"></i>
                    <h5 class="card-title">Criar Questão</h5>
                    <p class="card-text">Crie uma nova questão</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="bi bi-aspect-ratio" style="font-size:2rem;"></i>
                    <h5 class="card-title">Criar Formulário</h5>
                    <p class="card-text">Crie um novo formulário</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="bi bi-list" style="font-size:2rem;"></i>
                    <h5 class="card-title">Formulários</h5>
                    <p class="card-text">Visualize todos os formulários</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="bi bi-list" style="font-size:2rem;"></i>
                    <h5 class="card-title">Questões</h5>
                    <p class="card-text">Visualize todas as questões</p>
                </div>
            </div>
        </div>
    </div>
    <div class="text-center mt-4">
        <form method="post" asp-page-handler="Logout">
            <button type="submit" class="btn btn-outline-danger">Sair</button>
        </form>
    </div>
</div>

<!-- Bootstrap e Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"titulo\": \"Pesquisa de Satisfação\",\n    \"descricao\": \"Pesquisa para avaliar a satisfação dos alunos com o curso\",\n    \"dataExpiracao\": \"2024-12-31T23:59:59Z\",\n    \"ordemAleatoria\": true,\n    \"questoes\": [\n        {\n            \"questaoId\": \"{{questaoEscalaId}}\",\n            \"ordem\": 1\n        },\n        {\n            \"questaoId\": \"{{questaoMultiplaId}}\",\n            \"ordem\": 2\n        },\n        {\n            \"questaoId\": \"{{questaoTextoId}}\",\n            \"ordem\": 3\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/Questionario/com-questoes",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"Questionario",
								"com-questoes"
							]
						}
					}
				},
				{
					"name": "Verificar Questionário para Resposta",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Questionário tem as questões corretas\", function () {",
									"    pm.expect(jsonData.questoes).to.have.lengthOf(3);",
									"});",
									"",
									"pm.test(\"Ordem aleatória está ativa\", function () {",
									"    pm.expect(jsonData.ordemAleatoria).to.be.true;",
									"});",
									"",
									"pm.test(\"Questões têm tipos diferentes\", function () {",
									"    const tipos = jsonData.questoes.map(q => q.tipo);",
									"    pm.expect(tipos).to.include('Escala');",
									"    pm.expect(tipos).to.include('MultiplaEscolha');",
									"    pm.expect(tipos).to.include('Texto');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
